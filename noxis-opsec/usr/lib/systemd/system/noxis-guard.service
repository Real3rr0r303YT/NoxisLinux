[Unit]
Description=Noxis Guard: Neustart nach langer Sperre, WLAN/Bluetooth automatisch aus, 2G sperren
After=NetworkManager.service ModemManager.service bluetooth.service systemd-logind.service

[Service]
ExecStart=/usr/lib/noxis/guard/noxis-guard-daemon
Restart=always
RestartSec=10
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

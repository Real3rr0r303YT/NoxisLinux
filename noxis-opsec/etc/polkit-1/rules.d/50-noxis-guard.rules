// Noxis Guard: Schalter ohne Passwort fuer die angemeldete Person am Geraet
// (wie in Noxis OS). Der Helfer nimmt nur feste Befehle und Werte an.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/lib/noxis/guard/noxis-guard-helper" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});

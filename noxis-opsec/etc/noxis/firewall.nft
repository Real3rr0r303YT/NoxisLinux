#!/usr/sbin/nft -f
# ============================================================
#  Noxis Linux – Firewall
#  Inbound: everything blocked.  Outbound: only through the Mullvad tunnel.
#  Runs IN ADDITION to Mullvad's own killswitch table.
# ============================================================

table inet noxis
delete table inet noxis

table inet noxis {
	# Mullvad marks its own relay/API traffic with this fwmark ("mole")
	define MULLVAD_MARK = 0x6d6f6c65

	set tunnel_ifs {
		type ifname
		elements = { "wg0-mullvad", "wg-mullvad" }
	}

	chain input {
		type filter hook input priority filter - 10; policy drop;

		iif "lo" accept
		ct state invalid drop
		ct state established,related accept

		# IPv6 neighbour discovery and router advertisements (otherwise no IPv6)
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, packet-too-big } accept
		icmp type { echo-reply, destination-unreachable, time-exceeded } accept

		# DHCP-Antworten
		udp sport 67 udp dport 68 accept
		udp sport 547 udp dport 546 accept

		# Waydroid container: only DNS/DHCP from the host
		iifname "waydroid0" udp dport { 53, 67 } accept
		iifname "waydroid0" tcp dport 53 accept

		counter comment "dropped: inbound"
	}

	chain forward {
		type filter hook forward priority filter - 10; policy drop;

		ct state invalid drop
		ct state established,related accept
		# Waydroid may only use the tunnel
		iifname "waydroid0" oifname @tunnel_ifs accept

		counter comment "verworfen: weitergeleitet"
	}

	chain output {
		type filter hook output priority filter - 10; policy drop;

		oif "lo" accept
		ct state invalid drop
		ct state established,related accept

		# everything going through the tunnel
		oifname @tunnel_ifs accept
		# Mullvad's own connection to the relay / API
		meta mark $MULLVAD_MARK accept

		# basic networking (without it the phone gets no address)
		udp sport 68 udp dport 67 accept
		udp sport 546 udp dport 547 accept
		icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept

		# Waydroid-Bridge (Container ↔ Host)
		oifname "waydroid0" accept

		counter comment "dropped: outbound"
	}
}

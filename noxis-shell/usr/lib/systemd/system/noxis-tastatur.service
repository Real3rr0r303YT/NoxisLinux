[Unit]
Description=Noxis: Groesse der Bildschirmtastatur herstellen
# Vor der Oberflaeche, damit squeekboard die fertigen Layouts liest.
Before=display-manager.service phosh.service
ConditionPathIsDirectory=/usr/share/squeekboard/keyboards

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/noxis/shell/noxis-tastatur anwenden
# Eine zu kleine Tastatur ist aergerlich, aber kein Grund, den Start
# anzuhalten.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target

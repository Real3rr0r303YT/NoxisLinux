#!/usr/bin/python3
"""noxis-dm – the Noxis Linux display manager.

Flow: start the greeter as its own system user in its own PAM session (class greeter) →
the greeter speaks the greetd protocol over $GREETD_SOCK → PIN is checked via PAM →
greeter exits → user session (class user) with PAM, logind and dropped privileges →
back to the greeter after logout. First boot: language + time zone setup (noxis_setup)."""
import configparser
import fcntl
import json
import os
import pwd
import signal
import socket
import struct
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import pam  # noqa: E402
import setup  # noqa: E402

CONF = os.environ.get("NOXIS_DM_CONF", "/etc/noxis/dm.conf")
VT_ACTIVATE, VT_WAITACTIVE = 0x5606, 0x5607
TIOCSCTTY = 0x540E
AUTH_FAIL = {pam.PAM_AUTH_ERR, pam.PAM_USER_UNKNOWN, pam.PAM_MAXTRIES, pam.PAM_PERM_DENIED}
ENV_ALLOWED_PREFIX = ("NOXIS_",)
ENV_ALLOWED = {"XDG_SESSION_DESKTOP", "XDG_CURRENT_DESKTOP", "DESKTOP_SESSION"}


def log(msg):
    print(f"noxis-dm: {msg}", file=sys.stderr, flush=True)


def load_conf(path=None):
    cp = configparser.ConfigParser()
    cp.read(path or CONF)
    s = cp["dm"] if cp.has_section("dm") else {}
    return {
        "vt": int(s.get("vt", "1")),
        "greeter_user": s.get("greeter_user", "noxis-greeter"),
        "greeter_cmd": s.get("greeter_cmd", "cage -s -m last -- /usr/lib/noxis/greeter/noxis-greeter"),
        "pam_service": s.get("pam_service", "noxis"),
        "greeter_pam_service": s.get("greeter_pam_service", "noxis-greeter"),
        "sessions": [x.strip() for x in s.get("sessions", "phosh-session").split(",") if x.strip()],
        "run_dir": s.get("run_dir", "/run/noxis-dm"),
        "pam_confdir": s.get("pam_confdir", "") or None,
        "renderer": s.get("renderer", "pixman"),
    }


# ------------------------------------------------------------------ protocol
def recv_msg(conn):
    hdr = b""
    while len(hdr) < 4:
        c = conn.recv(4 - len(hdr))
        if not c:
            return None
        hdr += c
    (n,) = struct.unpack("=I", hdr)
    if n > 65536:
        raise ValueError("message too large")
    buf = b""
    while len(buf) < n:
        c = conn.recv(n - len(buf))
        if not c:
            return None
        buf += c
    return json.loads(buf)


def send_msg(conn, msg):
    data = json.dumps(msg).encode()
    conn.sendall(struct.pack("=I", len(data)) + data)


def err(kind, text):
    return {"type": "error", "error_type": kind, "description": text}


class Cancelled(Exception):
    pass


class Authenticator:
    """greetd protocol + PAM. State survives across connections (like greetd)."""

    def __init__(self, conf):
        self.conf = conf
        self.pam = None
        self.user = None
        self.authed = False
        self.session = None          # (cmd, env) after start_session
        self.conn = None

    def reset(self):
        if self.pam:
            self.pam.end()
        self.pam, self.user, self.authed, self.session = None, None, False, None

    # PAM prompt → auth_message to the greeter, then read the next request
    def _ask(self, style, text):
        kind = {pam.PAM_PROMPT_ECHO_OFF: "secret", pam.PAM_PROMPT_ECHO_ON: "visible",
                pam.PAM_ERROR_MSG: "error", pam.PAM_TEXT_INFO: "info"}.get(style, "info")
        send_msg(self.conn, {"type": "auth_message", "auth_message_type": kind, "auth_message": text})
        req = recv_msg(self.conn)
        if req is None or req.get("type") == "cancel_session":
            self.cancelled = True
            return None
        if req.get("type") != "post_auth_message_response":
            self.cancelled = True
            return None
        r = req.get("response")
        return r if isinstance(r, str) else ""

    def handle(self, conn):
        self.conn = conn
        while True:
            req = recv_msg(conn)
            if req is None:
                return
            send_msg(conn, self.dispatch(req))

    def dispatch(self, req):
        t = req.get("type")
        if t == "create_session":
            if self.pam:
                return err("error", "A login is already in progress")
            user = req.get("username")
            if not isinstance(user, str) or not user or "/" in user:
                return err("error", "Invalid user")
            self.cancelled = False
            stage = "auth"
            try:
                self.pam = pam.Pam(self.conf["pam_service"], user, self._ask, self.conf["pam_confdir"])
                self.user = user
                if self.conf["vt"]:
                    self.pam.set_tty(f"tty{self.conf['vt']}")
                self.pam.authenticate()
                stage = "account"
                self.pam.acct_mgmt()
            except pam.PamError as e:
                cancelled = self.cancelled
                self.reset()
                if cancelled:
                    return {"type": "success"}          # reply to cancel_session
                # any failure while checking the PIN counts as a wrong PIN (reveals nothing about accounts)
                if stage == "auth" or e.code in AUTH_FAIL or e.code == pam.PAM_CONV_ERR:
                    return err("auth_error", "Authentication failed")
                if e.code == pam.PAM_NEW_AUTHTOK_REQD:
                    return err("error", "PIN expired – change it on a terminal")
                return err("error", str(e))
            self.authed = True
            return {"type": "success"}
        if t == "post_auth_message_response":
            return err("error", "No pending prompt")
        if t == "start_session":
            if not self.authed:
                return err("error", "Not authenticated")
            cmd = req.get("cmd")
            if not (isinstance(cmd, list) and cmd and all(isinstance(c, str) for c in cmd)):
                return err("error", "Invalid command")
            if os.path.basename(cmd[0]) not in self.conf["sessions"]:
                return err("error", f"Session not allowed: {cmd[0]}")
            env = {}
            for kv in req.get("env") or []:
                if isinstance(kv, str) and "=" in kv:
                    k, v = kv.split("=", 1)
                    if k.startswith(ENV_ALLOWED_PREFIX) or k in ENV_ALLOWED:
                        env[k] = v
            self.session = (cmd, env)
            return {"type": "success"}
        if t == "cancel_session":
            self.reset()
            return {"type": "success"}
        if t == "noxis_setup_info":
            lang = req.get("lang") if req.get("lang") in setup.LANGS else "en"
            root = self.conf.get("setup_root", "/")
            tz, source, zones = setup.suggest(lang, setup.detect_mcc(), root)
            return {"type": "noxis_setup_info", "needed": not setup.is_done(root), "suggested": tz,
                    "source": source, "zones": zones, "all_zones": setup.all_zones(root)}
        if t == "noxis_setup":
            root = self.conf.get("setup_root", "/")
            if setup.is_done(root):          # after first boot: change only when logged in (Settings)
                return err("error", "Setup already done")
            try:
                setup.apply(req.get("lang"), req.get("timezone"), root, compile_schemas=(root == "/"))
            except (ValueError, OSError) as e:
                return err("error", str(e))
            log(f"setup: lang={req.get('lang')} tz={req.get('timezone')}")
            return {"type": "success"}
        return err("error", "Unknown request")


# ------------------------------------------------------------------ processes
def activate_vt(vt):
    if not vt:
        return
    try:
        fd = os.open("/dev/tty0", os.O_RDWR | os.O_NOCTTY)
        try:
            fcntl.ioctl(fd, VT_ACTIVATE, vt)
            fcntl.ioctl(fd, VT_WAITACTIVE, vt)
        finally:
            os.close(fd)
    except OSError as e:
        log(f"cannot activate VT {vt}: {e}")


def base_env(pw, conf, cls):
    env = {
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "HOME": pw.pw_dir, "SHELL": pw.pw_shell or "/bin/sh",
        "USER": pw.pw_name, "LOGNAME": pw.pw_name,
        "XDG_SESSION_TYPE": "wayland", "XDG_SESSION_CLASS": cls, "XDG_SEAT": "seat0",
    }
    if conf["vt"]:
        env["XDG_VTNR"] = str(conf["vt"])
    # Mesa hat keinen GL-Treiber fuer Qualcomms KGSL; freedreno spricht nur mit
    # dem Mainline-msm-Treiber. EGL scheitert deshalb mit "DRI2: failed to load
    # driver", und wlroots bricht ohne Renderer ab. pixman rendert in Software,
    # das genuegt fuer Greeter und Oberflaeche. renderer = gles2 in dm.conf
    # schaltet wieder auf Hardware um, sobald es einen Treiber gibt.
    if conf.get("renderer"):
        env["WLR_RENDERER"] = conf["renderer"]
        if conf["renderer"] == "pixman":
            env["WLR_RENDERER_ALLOW_SOFTWARE"] = "1"
            env["GSK_RENDERER"] = "cairo"
    return env


def spawn(pw, argv, env, vt):
    """Child: new session, VT as controlling terminal, drop privileges, exec."""
    pid = os.fork()
    if pid:
        return pid
    try:
        os.setsid()
        if vt:
            fd = os.open(f"/dev/tty{vt}", os.O_RDWR)
            fcntl.ioctl(fd, TIOCSCTTY, 1)
            os.dup2(fd, 0)
            if fd > 2:
                os.close(fd)
        os.initgroups(pw.pw_name, pw.pw_gid)
        os.setgid(pw.pw_gid)
        os.setuid(pw.pw_uid)
        if os.getuid() != pw.pw_uid or os.geteuid() != pw.pw_uid:
            os._exit(126)
        try:
            os.chdir(pw.pw_dir)
        except OSError:
            os.chdir("/")
        os.umask(0o077)
        os.execvpe(argv[0], argv, env)
    except Exception as e:  # noqa: BLE001
        print(f"noxis-dm: exec failed: {e}", file=sys.stderr, flush=True)
    os._exit(127)


def open_pam_session(p, pw, conf, cls, extra_env=None, establish=True):
    for k, v in base_env(pw, conf, cls).items():
        if k.startswith("XDG_"):
            p.putenv(k, v)
    if establish:
        p.setcred(True)
    p.open_session()
    env = base_env(pw, conf, cls)
    env.update(p.envlist())
    env.update(extra_env or {})
    # pam_systemd liefert XDG_RUNTIME_DIR normalerweise mit. Nach einem
    # Fehlversuch des Greeters ist die logind-Sitzung noch im Abbau und die
    # Variable fehlt beim naechsten Versuch -- cage bricht dann sofort mit
    # "XDG_RUNTIME_DIR is not set" ab, und zwar immer wieder. Notfalls selbst
    # setzen und das Verzeichnis anlegen.
    rd = env.get("XDG_RUNTIME_DIR")
    if not rd:
        rd = f"/run/user/{pw.pw_uid}"
        env["XDG_RUNTIME_DIR"] = rd
        log(f"XDG_RUNTIME_DIR fehlte, benutze {rd}")
    try:
        os.makedirs(rd, mode=0o700, exist_ok=True)
        os.chown(rd, pw.pw_uid, pw.pw_gid)
        os.chmod(rd, 0o700)
    except OSError as e:
        log(f"XDG_RUNTIME_DIR {rd}: {e}")
    return env


def wait_child(pid, poll=None):
    """Wait for the child; poll() is called regularly (for the greeter socket)."""
    while True:
        try:
            done, status = os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            return 0
        if done:
            return status
        if poll:
            poll()
        else:
            time.sleep(0.2)


class DM:
    def __init__(self, conf):
        self.conf = conf
        self.auth = Authenticator(conf)
        self.children = set()

    def run_greeter(self):
        """Start and serve the greeter. Returns True when a user session is ready."""
        conf = self.conf
        gpw = pwd.getpwnam(conf["greeter_user"])
        os.makedirs(conf["run_dir"], mode=0o755, exist_ok=True)
        sock_path = os.path.join(conf["run_dir"], "greeter.sock")
        if os.path.exists(sock_path):
            os.unlink(sock_path)
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(sock_path)
        os.chown(sock_path, gpw.pw_uid, gpw.pw_gid)
        os.chmod(sock_path, 0o600)
        srv.listen(1)
        srv.settimeout(0.2)

        gp = pam.Pam(conf["greeter_pam_service"], gpw.pw_name, lambda *_: None, conf["pam_confdir"])
        try:
            if conf["vt"]:
                gp.set_tty(f"tty{conf['vt']}")
            gp.acct_mgmt()
            env = open_pam_session(gp, gpw, conf, "greeter", {"GREETD_SOCK": sock_path})
            activate_vt(conf["vt"])
            argv = ["/bin/sh", "-c", f"exec {conf['greeter_cmd']}"]
            pid = spawn(gpw, argv, env, conf["vt"])
            self.children.add(pid)

            def poll():
                try:
                    conn, _ = srv.accept()
                except socket.timeout:
                    return
                conn.settimeout(None)
                cred = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
                _pid, uid, _gid = struct.unpack("3i", cred)
                if uid not in (gpw.pw_uid, 0):
                    log(f"rejected socket access from uid {uid}")
                    conn.close()
                    return
                try:
                    self.auth.handle(conn)
                except (OSError, ValueError) as e:
                    log(f"greeter connection: {e}")
                finally:
                    conn.close()

            status = wait_child(pid, poll)
            self.children.discard(pid)
            log(f"greeter exited (status {status})")
        finally:
            gp.close_session()
            gp.end()
            srv.close()
            try:
                os.unlink(sock_path)
            except OSError:
                pass
        return self.auth.session is not None and self.auth.authed

    def run_session(self):
        a = self.auth
        cmd, extra = a.session
        pw = pwd.getpwnam(a.user)
        try:
            env = open_pam_session(a.pam, pw, self.conf, "user", extra)
            shell = pw.pw_shell if pw.pw_shell and os.path.exists(pw.pw_shell) else "/bin/sh"
            argv = [shell, "-l", "-c", 'exec "$@"', "noxis-session"] + cmd
            log(f"session for {pw.pw_name}: {' '.join(cmd)}")
            pid = spawn(pw, argv, env, self.conf["vt"])
            self.children.add(pid)
            status = wait_child(pid)
            self.children.discard(pid)
            log(f"session ended (status {status})")
        except pam.PamError as e:
            log(f"session not started: {e}")
        finally:
            if a.pam:
                a.pam.close_session()
                try:
                    a.pam.setcred(False)
                except pam.PamError:
                    pass
            a.reset()

    def loop(self):
        fails = []
        while True:
            try:
                ready = self.run_greeter()
            except (KeyError, OSError, pam.PamError) as e:
                log(f"greeter error: {e}")
                ready = False
            if ready:
                fails.clear()
                self.run_session()
                continue
            self.auth.reset()
            now = time.time()
            fails = [t for t in fails if now - t < 60] + [now]
            if len(fails) >= 5:
                log("greeter keeps failing – pausing 30 s")
                time.sleep(30)
                fails.clear()
            else:
                time.sleep(1)

    def shutdown(self, *_):
        for pid in list(self.children):
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        self.auth.reset()
        sys.exit(0)


def main():
    if os.geteuid() != 0:
        log("must run as root")
        return 1
    dm = DM(load_conf())
    signal.signal(signal.SIGTERM, dm.shutdown)
    signal.signal(signal.SIGINT, dm.shutdown)
    dm.loop()
    return 0


if __name__ == "__main__":
    sys.exit(main())

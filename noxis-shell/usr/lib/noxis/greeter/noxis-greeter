#!/usr/bin/python3
"""Noxis greeter: login screen for noxis-dm (runs inside cage).
First boot: language + time zone wizard. Afterwards: clock, logo, shuffled PIN pad,
status icons (VPN, network, battery), session choice with icons, restart/power off."""
import os
import subprocess
import sys
import threading
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

import core  # noqa: E402
import i18n  # noqa: E402
from greetd_ipc import Greetd, GreetdError  # noqa: E402

BRAND = os.environ.get("NOXIS_BRANDING", "/usr/share/noxis/branding")
HERE = os.path.dirname(os.path.realpath(__file__))
SESSION_ICONS = {"mobile": "phone-symbolic", "desktop": "video-display-symbolic"}


def icon_label(icon, text, css=None):
    box = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
    img = Gtk.Image.new_from_icon_name(icon)
    img.set_pixel_size(18)
    box.append(img)
    lbl = Gtk.Label(label=text)
    box.append(lbl)
    if css:
        box.add_css_class(css)
    return box, lbl


class Greeter(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Noxis")
        self.lang = i18n.lang_from_env()
        self.conf = core.load_conf()
        self.user = core.pick_user(self.conf)
        self.pin = core.PinState()
        self.failures = 0
        self.locked_until = 0.0
        self.busy = False
        self.mode = core.default_mode()
        self.setup_data = None
        self.sp_tz, self.sp_first, self.sp_buf = None, None, None
        self.sp_name, self.sp_user = None, None

        self.overlay = Gtk.Overlay()
        self.set_child(self.overlay)
        self.bg = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, can_shrink=True)
        self.overlay.set_child(self.bg)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.overlay.add_overlay(self.stack)

        self.build_login()
        self.stack.add_named(self.login_page, "login")

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

        self.update_background()
        self.tick()
        GLib.timeout_add_seconds(1, self.tick)
        GLib.timeout_add_seconds(2, self.poll_outputs)
        GLib.timeout_add_seconds(5, self.update_status)
        self.update_status()
        threading.Thread(target=self.load_setup_info, daemon=True).start()

    # ============================================================ Login
    def build_login(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, css_classes=["noxis-root"])
        self.login_page = root

        self.status = Gtk.Box(spacing=14, halign=Gtk.Align.END, css_classes=["noxis-status"])
        self.st_vpn = Gtk.Image(pixel_size=16)
        self.st_net = Gtk.Image(pixel_size=16)
        self.st_bat = Gtk.Image(pixel_size=16)
        self.st_bat_lbl = Gtk.Label(css_classes=["noxis-status-text"])
        for w in (self.st_vpn, self.st_net, self.st_bat, self.st_bat_lbl):
            self.status.append(w)
        root.append(self.status)

        self.clock = Gtk.Label(css_classes=["noxis-clock"])
        self.date = Gtk.Label(css_classes=["noxis-date"])
        root.append(self.clock)
        root.append(self.date)
        root.append(Gtk.Box(vexpand=True))

        logo = Gtk.Picture.new_for_filename(os.path.join(BRAND, "noxis-wordmark.svg"))
        logo.set_content_fit(Gtk.ContentFit.CONTAIN)
        logo.set_size_request(220, 60)
        logo.set_halign(Gtk.Align.CENTER)
        logo.add_css_class("noxis-logo")
        root.append(logo)
        if self.conf["show_user"] and self.user:
            root.append(Gtk.Label(label=self.user, css_classes=["noxis-user"]))

        self.dots = Gtk.Label(label=" ", css_classes=["noxis-dots"])
        self.msg = Gtk.Label(label=" ", css_classes=["noxis-msg"])
        root.append(self.dots)
        root.append(self.msg)

        self.grid = Gtk.Grid(row_spacing=14, column_spacing=22, halign=Gtk.Align.CENTER, css_classes=["noxis-keypad"])
        root.append(self.grid)
        self.build_keypad()
        root.append(Gtk.Box(vexpand=True))

        foot = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER, css_classes=["noxis-foot"])
        self.mode_btns, self.mode_lbls = {}, {}
        group = None
        for key in ("mobile", "desktop"):
            b = Gtk.ToggleButton(css_classes=["noxis-chip"])
            content, lbl = icon_label(SESSION_ICONS[key], "")
            b.set_child(content)
            if group:
                b.set_group(group)
            group = group or b
            b.set_active(key == self.mode)
            b.connect("toggled", self.on_mode, key)
            foot.append(b)
            self.mode_btns[key], self.mode_lbls[key] = b, lbl
        foot.append(Gtk.Box(width_request=18))
        self.power_btns = {}
        for icon, key, cmd in (("system-reboot-symbolic", "reboot", "reboot"),
                               ("system-shutdown-symbolic", "poweroff", "poweroff")):
            b = Gtk.Button(icon_name=icon, css_classes=["noxis-power"])
            b.connect("clicked", self.on_power, cmd)
            foot.append(b)
            self.power_btns[key] = b
        root.append(foot)
        self.apply_texts()

    def apply_texts(self):
        for key, lbl in self.mode_lbls.items():
            lbl.set_label(i18n.tr(self.lang, key))
        for key, b in self.power_btns.items():
            b.set_tooltip_text(i18n.tr(self.lang, key))
        if not self.user:
            self.show_msg(i18n.tr(self.lang, "no_user"))
        self.tick()

    def build_keypad(self):
        child = self.grid.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.grid.remove(child)
            child = nxt
        for i, k in enumerate(core.keypad(self.conf["shuffle"])):
            if k == "⌫":
                b = Gtk.Button(icon_name="edit-clear-symbolic", css_classes=["noxis-key", "noxis-key-side"])
                b.connect("clicked", lambda *_: self.on_back())
            elif k == "✓":
                b = Gtk.Button(icon_name="object-select-symbolic", css_classes=["noxis-key", "noxis-key-ok"])
                b.connect("clicked", lambda *_: self.submit())
            else:
                b = Gtk.Button(label=k, css_classes=["noxis-key"])
                b.connect("clicked", lambda _b, d=k: self.on_digit(d))
            self.grid.attach(b, i % 3, i // 3, 1, 1)

    def update_background(self):
        w = self.get_width() or 1080
        h = self.get_height() or 2392
        name = "noxis-wallpaper-landscape.svg" if w > h else "noxis-wallpaper-portrait.svg"
        self.bg.set_filename(os.path.join(BRAND, name))

    def update_status(self):
        st = core.status()
        self.st_vpn.set_from_icon_name("network-vpn-symbolic" if st["vpn"] else "network-vpn-disabled-symbolic")
        self.st_vpn.set_tooltip_text(i18n.tr(self.lang, "vpn_on" if st["vpn"] else "vpn_off"))
        self.st_vpn.set_css_classes(["noxis-ok" if st["vpn"] else "noxis-warn"])
        self.st_net.set_from_icon_name(st["net_icon"])
        self.st_net.set_tooltip_text(i18n.tr(self.lang, "network"))
        if st["battery"] is None:
            self.st_bat.set_visible(False)
            self.st_bat_lbl.set_visible(False)
        else:
            self.st_bat.set_from_icon_name(st["bat_icon"])
            self.st_bat_lbl.set_label(f"{st['battery']} %")
            self.st_bat.set_tooltip_text(i18n.tr(self.lang, "battery"))
        return True

    def refresh_dots(self):
        self.dots.set_label("●  " * len(self.pin) if len(self.pin) else " ")

    def show_msg(self, text):
        self.msg.set_label(text or " ")

    def tick(self):
        t = time.localtime()
        self.clock.set_label(time.strftime("%H:%M", t))
        self.date.set_label(i18n.date_text(self.lang, t))
        rest = int(self.locked_until - time.time())
        if rest > 0:
            self.show_msg(i18n.tr(self.lang, "wait", s=rest))
        elif self.locked_until and not self.busy:
            self.locked_until = 0
            self.show_msg(" ")
        return True

    def poll_outputs(self):
        self.update_background()
        want = core.default_mode()
        if want != self.mode and not self.mode_btns[want].get_active():
            self.mode_btns[want].set_active(True)
        return True

    # ============================================================ First-boot setup
    def load_setup_info(self):
        try:
            g = Greetd()
            try:
                info = g.setup_info(self.lang)
            finally:
                g.close()
        except (GreetdError, OSError) as e:
            print(f"noxis-greeter: setup info failed: {e}", file=sys.stderr, flush=True)
            return
        print(f"noxis-greeter: setup info: needed={info.get('needed')} user_needed={info.get('user_needed')}",
              file=sys.stderr, flush=True)
        if info.get("type") == "noxis_setup_info" and (info.get("needed") or info.get("user_needed")):
            GLib.idle_add(self.start_setup, info)

    def start_setup(self, info):
        try:
            self._start_setup(info)
        except Exception:  # noqa: BLE001 -- sonst verschwindet der Fehler still im Idle-Callback
            import traceback
            traceback.print_exc()
        return False

    def _start_setup(self, info):
        self.setup_data = info
        if not info.get("needed"):
            # Sprache und Zeitzone standen schon beim Bauen fest -- dann bleibt
            # nur die PIN, und die wird trotzdem abgefragt.
            self.show_name_page(None)
            return False
        self.stack.add_named(self.build_lang_page(), "lang")
        self.stack.set_visible_child_name("lang")
        return False

    def build_lang_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, css_classes=["noxis-root", "noxis-setup"])
        logo = Gtk.Picture.new_for_filename(os.path.join(BRAND, "noxis-mark.svg"))
        logo.set_size_request(96, 96)
        logo.set_halign(Gtk.Align.CENTER)
        page.append(logo)
        self.lang_title = Gtk.Label(label=i18n.tr(self.lang, "welcome"), css_classes=["noxis-title"])
        self.lang_sub = Gtk.Label(label=i18n.tr(self.lang, "choose_lang"), css_classes=["noxis-subtitle"])
        page.append(self.lang_title)
        page.append(self.lang_sub)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, valign=Gtk.Align.CENTER, vexpand=True)
        for code in i18n.ORDER:
            b = Gtk.Button(css_classes=["noxis-list-btn"])
            row, _ = icon_label("preferences-desktop-locale-symbolic", i18n.LANGS[code][0])
            b.set_child(row)
            b.connect("clicked", self.on_lang, code)
            box.append(b)
        page.append(box)
        return page

    def on_lang(self, _b, code):
        self.lang = code
        self.apply_texts()
        threading.Thread(target=self._reload_info, daemon=True).start()

    def _reload_info(self):
        try:
            g = Greetd()
            try:
                info = g.setup_info(self.lang)
            finally:
                g.close()
        except (GreetdError, OSError):
            info = self.setup_data
        GLib.idle_add(self.show_tz_page, info)

    def show_tz_page(self, info):
        self.setup_data = info
        old = self.stack.get_child_by_name("tz")
        if old:
            self.stack.remove(old)
        self.stack.add_named(self.build_tz_page(info), "tz")
        self.stack.set_visible_child_name("tz")
        return False

    def build_tz_page(self, info):
        lang = self.lang
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, css_classes=["noxis-root", "noxis-setup"])
        title, _ = icon_label("preferences-system-time-symbolic", i18n.tr(lang, "timezone"), "noxis-title")
        page.append(title)
        self.tz_choice = info.get("suggested") or "UTC"
        src = {"network": "det_network", "lang": "det_lang"}.get(info.get("source"))
        sug = Gtk.Button(css_classes=["noxis-list-btn", "noxis-suggested"])
        sug_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        sug_box.append(Gtk.Label(label=self.tz_choice.replace("_", " "), css_classes=["noxis-tz-main"]))
        if src:
            sug_box.append(Gtk.Label(label=i18n.tr(lang, src), css_classes=["noxis-tz-src"]))
        sug.set_child(sug_box)
        sug.connect("clicked", lambda *_: self.show_name_page(self.tz_choice))
        page.append(sug)

        search = Gtk.SearchEntry(placeholder_text=i18n.tr(lang, "search"))
        page.append(search)
        lst = Gtk.ListBox(css_classes=["noxis-tz-list"], selection_mode=Gtk.SelectionMode.SINGLE)
        zones = list(dict.fromkeys((info.get("zones") or []) + (info.get("all_zones") or ["UTC"])))
        for tz in zones:
            row = Gtk.ListBoxRow()
            row.tz = tz
            row.set_child(Gtk.Label(label=tz.replace("_", " "), xalign=0, css_classes=["noxis-tz-row"]))
            lst.append(row)
        needle = {"q": ""}
        lst.set_filter_func(lambda row: needle["q"] in row.tz.lower().replace("_", " "))
        search.connect("search-changed", lambda e: (needle.__setitem__("q", e.get_text().lower()), lst.invalidate_filter()))
        lst.connect("row-activated", lambda _l, row: self.show_name_page(row.tz))
        scroller = Gtk.ScrolledWindow(vexpand=True, child=lst)
        page.append(scroller)

        nav = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER, margin_bottom=56)
        back = Gtk.Button(label=i18n.tr(lang, "back"), css_classes=["noxis-chip"])
        back.connect("clicked", lambda *_: self.stack.set_visible_child_name("lang"))
        nxt = Gtk.Button(label=i18n.tr(lang, "next"), css_classes=["noxis-chip", "noxis-primary"])
        nxt.connect("clicked", lambda *_: self.show_name_page(self.selected_tz(lst) or self.tz_choice))
        nav.append(back)
        nav.append(nxt)
        page.append(nav)
        self.setup_msg = Gtk.Label(label=" ", css_classes=["noxis-msg"])
        page.append(self.setup_msg)
        return page

    @staticmethod
    def selected_tz(lst):
        row = lst.get_selected_row()
        return getattr(row, "tz", None) if row else None

    # ---- Name + Benutzername -----------------------------------------------
    def show_name_page(self, tz):
        self.sp_tz = tz
        old = self.stack.get_child_by_name("name")
        if old:
            self.stack.remove(old)
        self.stack.add_named(self.build_name_page(), "name")
        self.stack.set_visible_child_name("name")

    def build_name_page(self):
        lang = self.lang
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, css_classes=["noxis-root", "noxis-setup"])
        title, _ = icon_label("avatar-default-symbolic", i18n.tr(lang, "who_title"), "noxis-title")
        page.append(title)
        cur = (self.setup_data or {}).get("user") or self.user or "noxis"
        page.append(Gtk.Label(label=i18n.tr(lang, "your_name"), xalign=0, css_classes=["noxis-subtitle"]))
        e_name = Gtk.Entry(text=self.sp_name or "")
        page.append(e_name)
        page.append(Gtk.Label(label=i18n.tr(lang, "username"), xalign=0, css_classes=["noxis-subtitle"]))
        e_user = Gtk.Entry(text=self.sp_user or cur)
        page.append(e_user)
        self.name_msg = Gtk.Label(label=" ", css_classes=["noxis-msg"], wrap=True)
        page.append(self.name_msg)
        st = {"target": e_name, "auto": self.sp_user is None}

        def slug(text):
            first = text.strip().lower().split(" ")[0] if text.strip() else ""
            out = "".join(c for c in first if c.isascii() and (c.isalnum() or c in "_-")).lstrip("0123456789-")
            return out[:32]

        class Proxy:   # die Bildschirmtastatur schreibt ins zuletzt angetippte Feld
            def get_text(self_):
                return st["target"].get_text()

            def set_text(self_, t):
                if st["target"] is e_user:
                    st["auto"] = False
                    t = t.lower().replace(" ", "")
                st["target"].set_text(t)
                if st["target"] is e_name and st["auto"]:
                    e_user.set_text(slug(t) or cur)

            def set_position(self_, pos):
                st["target"].set_position(pos)

        for e in (e_name, e_user):
            fc = Gtk.EventControllerFocus()
            fc.connect("enter", lambda _c, w=e: st.__setitem__("target", w))
            e.add_controller(fc)

        def go():
            name, user = e_name.get_text().strip(), e_user.get_text().strip()
            import re
            if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", user) or any(c in name for c in ":\n\r") or len(name) > 64:
                self.name_msg.set_label(i18n.tr(self.lang, "user_bad"))
                return
            self.sp_name, self.sp_user = (name or None), user
            self.show_pin_page(self.sp_tz)

        page.append(self.build_osk(Proxy(), go, ok_label=i18n.tr(lang, "next")))
        nav = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER, margin_bottom=56)
        if self.sp_tz is not None:
            back = Gtk.Button(label=i18n.tr(lang, "back"), css_classes=["noxis-chip"])
            back.connect("clicked", lambda *_: self.stack.set_visible_child_name("tz"))
            nav.append(back)
        page.append(nav)
        return page

    # ---- eigene PIN festlegen (zwei Durchgaenge) -----------------------
    # Hier kein gemischtes Zahlenfeld: beim Festlegen hilft die gewohnte
    # Anordnung, und es gibt noch kein Geheimnis zu schuetzen.
    def show_pin_page(self, tz):
        self.sp_tz = tz
        self.sp_first = None
        self.sp_buf = core.PinState(max_len=32)
        old = self.stack.get_child_by_name("setpin")
        if old:
            self.stack.remove(old)
        self.stack.add_named(self.build_pin_page(), "setpin")
        self.stack.set_visible_child_name("setpin")

    def build_pin_page(self):
        lang = self.lang
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                       css_classes=["noxis-root", "noxis-setup"])
        title, _ = icon_label("channel-secure-symbolic", i18n.tr(lang, "set_pin"), "noxis-title")
        page.append(title)
        self.sp_sub = Gtk.Label(label=i18n.tr(lang, "set_pin"), css_classes=["noxis-subtitle"])
        page.append(self.sp_sub)
        self.sp_dots = Gtk.Label(label=" ", css_classes=["noxis-dots"])
        page.append(self.sp_dots)
        self.sp_msg = Gtk.Label(label=" ", css_classes=["noxis-msg"])
        page.append(self.sp_msg)
        grid = Gtk.Grid(row_spacing=14, column_spacing=22, halign=Gtk.Align.CENTER,
                        valign=Gtk.Align.CENTER, vexpand=True, css_classes=["noxis-keypad"])
        for i, k in enumerate(core.keypad(shuffle=False)):
            if k == "⌫":
                b = Gtk.Button(icon_name="edit-clear-symbolic", css_classes=["noxis-key", "noxis-key-side"])
                b.connect("clicked", lambda *_: self.sp_back())
            elif k == "✓":
                b = Gtk.Button(icon_name="object-select-symbolic", css_classes=["noxis-key", "noxis-key-ok"])
                b.connect("clicked", lambda *_: self.sp_submit())
            else:
                b = Gtk.Button(label=k, css_classes=["noxis-key"])
                b.connect("clicked", lambda _b, d=k: self.sp_digit(d))
            grid.attach(b, i % 3, i // 3, 1, 1)
        page.append(grid)
        nav = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER, margin_bottom=56)
        back = Gtk.Button(label=i18n.tr(lang, "back"), css_classes=["noxis-chip"])
        back.connect("clicked", lambda *_: self.stack.set_visible_child_name("name"))
        nav.append(back)
        # Kein "Später": eine im Quelltext nachlesbare Standard-PIN, die in jedem
        # ausgelieferten Image dieselbe ist, waere keine PIN. Scheitert das
        # Setzen, bleibt die bisherige gueltig und man kann es erneut versuchen.
        page.append(nav)
        self.setup_msg = self.sp_msg
        return page

    def sp_refresh(self):
        self.sp_dots.set_label("•" * len(self.sp_buf) or " ")

    def sp_digit(self, d):
        if self.stack.get_visible_child_name() != "setpin":
            return
        self.sp_buf.add(d)
        self.sp_refresh()

    def sp_back(self):
        self.sp_buf.back()
        self.sp_refresh()

    def sp_submit(self):
        pin = self.sp_buf.take()
        self.sp_refresh()
        if len(pin) < 4:
            self.sp_msg.set_label(i18n.tr(self.lang, "pin_short"))
            return
        if self.sp_first is None:
            self.sp_first = pin
            self.sp_sub.set_label(i18n.tr(self.lang, "pin_repeat"))
            self.sp_msg.set_label(" ")
            return
        if pin != self.sp_first:
            self.sp_first = None
            self.sp_sub.set_label(i18n.tr(self.lang, "set_pin"))
            self.sp_msg.set_label(i18n.tr(self.lang, "pin_mismatch"))
            return
        self.finish_setup(self.sp_tz, pin)

    def finish_setup(self, tz, pin=None):
        self.setup_msg.set_label(i18n.tr(self.lang, "applying"))

        def work():
            try:
                g = Greetd()
                try:
                    # Reihenfolge: erst die PIN, dann Sprache und Zeitzone --
                    # setup.apply schreibt am Ende die Fertig-Markierung, und
                    # danach nimmt der Display-Manager keine PIN mehr an.
                    ok, detail = True, ""
                    if pin:
                        ok, detail = g.setup_user(pin=pin, name=self.sp_name, username=self.sp_user)
                    if ok and tz:
                        ok, detail = g.setup(self.lang, tz)
                finally:
                    g.close()
            except (GreetdError, OSError) as e:
                ok, detail = False, str(e)
            GLib.idle_add(self.setup_done, ok, detail, tz)

        threading.Thread(target=work, daemon=True).start()

    def setup_done(self, ok, detail, tz):
        if not ok:
            self.setup_msg.set_label(f"{i18n.tr(self.lang, 'setup_fail')}: {detail}")
            return False
        if tz:
            os.environ["TZ"] = f":/usr/share/zoneinfo/{tz}"
            time.tzset()
        self.conf = core.load_conf()
        self.user = core.pick_user(self.conf)      # nach dem Umbenennen neu bestimmen
        self.apply_texts()
        self.show_wifi_page()
        return False

    # ---- WLAN (optional) ------------------------------------------------
    def show_wifi_page(self):
        old = self.stack.get_child_by_name("wifi")
        if old:
            self.stack.remove(old)
        self.stack.add_named(self.build_wifi_page(), "wifi")
        self.stack.set_visible_child_name("wifi")
        self.wifi_rescan()

    def build_wifi_page(self):
        lang = self.lang
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, css_classes=["noxis-root", "noxis-setup"])
        title, _ = icon_label("network-wireless-symbolic", i18n.tr(lang, "wifi_title"), "noxis-title")
        page.append(title)
        page.append(Gtk.Label(label=i18n.tr(lang, "wifi_sub"), css_classes=["noxis-subtitle"], wrap=True))
        self.wifi_msg = Gtk.Label(label=" ", css_classes=["noxis-msg"], wrap=True)
        page.append(self.wifi_msg)
        self.wifi_inner = Gtk.Stack(vexpand=True)
        self.wifi_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.wifi_inner.add_named(Gtk.ScrolledWindow(vexpand=True, child=self.wifi_list), "list")

        pw = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.wifi_pw_lbl = Gtk.Label(label=" ", css_classes=["noxis-subtitle"])
        pw.append(self.wifi_pw_lbl)
        self.wifi_entry = Gtk.PasswordEntry(show_peek_icon=True)
        self.wifi_entry.connect("activate", lambda *_: self.wifi_do_connect())
        pw.append(self.wifi_entry)
        pw.append(self.build_osk(self.wifi_entry, self.wifi_do_connect))
        self.wifi_inner.add_named(pw, "password")
        page.append(self.wifi_inner)

        nav = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER, margin_bottom=56)
        self.wifi_back = Gtk.Button(label=i18n.tr(lang, "back"), css_classes=["noxis-chip"], visible=False)
        self.wifi_back.connect("clicked", lambda *_: self.wifi_show_list())
        rescan = Gtk.Button(label=i18n.tr(lang, "rescan"), css_classes=["noxis-chip"])
        rescan.connect("clicked", lambda *_: self.wifi_rescan())
        self.wifi_done = Gtk.Button(label=i18n.tr(lang, "skip"), css_classes=["noxis-chip", "noxis-primary"])
        self.wifi_done.connect("clicked", lambda *_: self.wifi_leave())
        for b in (self.wifi_back, rescan, self.wifi_done):
            nav.append(b)
        page.append(nav)
        self.wifi_ssid = None
        return page

    def wifi_leave(self):
        print("noxis-greeter: wifi page left", file=sys.stderr, flush=True)
        try:
            self.stack.set_visible_child_name("login")
            old = self.stack.get_child_by_name("wifi")
            if old:
                GLib.idle_add(lambda: (self.stack.remove(old), False)[1])
        except Exception:  # noqa: BLE001
            import traceback
            traceback.print_exc()

    def wifi_show_list(self):
        self.wifi_inner.set_visible_child_name("list")
        self.wifi_back.set_visible(False)

    def wifi_rescan(self):
        self.wifi_show_list()
        self.wifi_msg.set_label(i18n.tr(self.lang, "wifi_scan"))

        def work():
            try:
                g = Greetd()
                try:
                    nets, err = g.wifi_list(), None
                finally:
                    g.close()
            except (GreetdError, OSError) as e:
                nets, err = [], str(e)
            GLib.idle_add(self.wifi_fill, nets, err)

        threading.Thread(target=work, daemon=True).start()

    def wifi_fill(self, nets, err):
        child = self.wifi_list.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.wifi_list.remove(child)
            child = nxt
        if not nets:
            self.wifi_msg.set_label(i18n.tr(self.lang, "wifi_none") + (f" ({err})" if err else ""))
            return False
        self.wifi_msg.set_label(" ")
        for n in nets[:30]:
            bars = 4 if n["signal"] >= 75 else 3 if n["signal"] >= 50 else 2 if n["signal"] >= 25 else 1
            icon = ("network-wireless-signal-" + ["weak", "ok", "good", "excellent"][bars - 1]
                    + ("-symbolic" if not n["secure"] else "-secure-symbolic"))
            text = n["ssid"] + ("  ✓" if n.get("active") else "")
            b = Gtk.Button(css_classes=["noxis-list-btn"])
            row, _ = icon_label(icon, text)
            b.set_child(row)
            b.connect("clicked", lambda _b, net=n: self.wifi_pick(net))
            self.wifi_list.append(b)
        return False

    def wifi_pick(self, net):
        self.wifi_ssid = net["ssid"]
        if not net["secure"]:
            self.wifi_entry.set_text("")
            self.wifi_do_connect()
            return
        self.wifi_pw_lbl.set_label(i18n.tr(self.lang, "wifi_pw", ssid=net["ssid"]))
        self.wifi_entry.set_text("")
        self.wifi_inner.set_visible_child_name("password")
        self.wifi_back.set_visible(True)
        self.wifi_msg.set_label(" ")

    def wifi_do_connect(self):
        ssid, psk = self.wifi_ssid, self.wifi_entry.get_text()
        if not ssid:
            return
        self.wifi_msg.set_label(i18n.tr(self.lang, "wifi_conn"))

        def work():
            try:
                g = Greetd()
                try:
                    ok, detail = g.wifi_connect(ssid, psk)
                finally:
                    g.close()
            except (GreetdError, OSError) as e:
                ok, detail = False, str(e)
            GLib.idle_add(self.wifi_result, ssid, ok, detail)

        threading.Thread(target=work, daemon=True).start()

    def wifi_result(self, ssid, ok, detail):
        if ok:
            self.wifi_entry.set_text("")
            self.wifi_msg.set_label(i18n.tr(self.lang, "wifi_ok", ssid=ssid))
            self.wifi_done.set_label(i18n.tr(self.lang, "next"))
            self.wifi_show_list()
        else:
            self.wifi_msg.set_label(f"{i18n.tr(self.lang, 'wifi_fail')}: {detail}")
        return False

    # Bildschirmtastatur: im Greeter (cage) laeuft kein squeekboard.
    def build_osk(self, entry, on_enter, ok_label=None):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, css_classes=["noxis-osk"])
        st = {"shift": False, "sym": False}
        top = "qwertzuiop" if self.lang == "de" else "qwertyuiop"
        bottom = "yxcvbnm" if self.lang == "de" else "zxcvbnm"
        letters = [top, "asdfghjkl", bottom]
        symbols = ["1234567890", "-_.,@#!?&\"", "/:;()$%*+="]

        def put(t):
            entry.set_text(entry.get_text() + t)
            entry.set_position(-1)

        def back():
            entry.set_text(entry.get_text()[:-1])
            entry.set_position(-1)

        def redraw():
            child = box.get_first_child()
            while child:
                nxt = child.get_next_sibling()
                box.remove(child)
                child = nxt
            rows = symbols if st["sym"] else letters
            for i, keys in enumerate(rows):
                r = Gtk.Box(spacing=4, halign=Gtk.Align.CENTER, homogeneous=True)
                if i == 2 and not st["sym"]:
                    sh = Gtk.Button(label="⇧", css_classes=["noxis-osk-key"] + (["noxis-primary"] if st["shift"] else []))
                    sh.connect("clicked", lambda *_: (st.__setitem__("shift", not st["shift"]), redraw()))
                    r.append(sh)
                for k in keys:
                    k = k.upper() if st["shift"] and not st["sym"] else k
                    b = Gtk.Button(label=k, css_classes=["noxis-osk-key"])
                    b.connect("clicked", lambda _b, c=k: put(c))
                    r.append(b)
                if i == 2:
                    bs = Gtk.Button(icon_name="edit-clear-symbolic", css_classes=["noxis-osk-key"])
                    bs.connect("clicked", lambda *_: back())
                    r.append(bs)
                box.append(r)
            last = Gtk.Box(spacing=4, halign=Gtk.Align.FILL)
            tg = Gtk.Button(label="abc" if st["sym"] else "123", css_classes=["noxis-osk-key"])
            tg.connect("clicked", lambda *_: (st.__setitem__("sym", not st["sym"]), redraw()))
            last.append(tg)
            sp = Gtk.Button(label=" ", hexpand=True, css_classes=["noxis-osk-key"])
            sp.connect("clicked", lambda *_: put(" "))
            last.append(sp)
            ok = Gtk.Button(label=ok_label or i18n.tr(self.lang, "connect"), css_classes=["noxis-osk-key", "noxis-primary"])
            ok.connect("clicked", lambda *_: on_enter())
            last.append(ok)
            box.append(last)

        redraw()
        return box

    # ============================================================ Input
    def on_mode(self, btn, key):
        if btn.get_active():
            self.mode = key

    def on_power(self, _b, cmd):
        subprocess.Popen(["systemctl", cmd])

    def on_digit(self, d):
        if self.busy or time.time() < self.locked_until or self.stack.get_visible_child_name() != "login":
            return
        self.pin.add(d)
        self.refresh_dots()
        n = self.conf["pin_length"]
        if n and len(self.pin) == n:
            self.submit()

    def on_back(self):
        if not self.busy:
            self.pin.back()
            self.refresh_dots()

    def on_key(self, _ctrl, keyval, _code, _state):
        page = self.stack.get_visible_child_name()
        if page == "setpin":
            name = Gdk.keyval_name(keyval) or ""
            if name.startswith("KP_") and name[3:].isdigit():
                name = name[3:]
            if len(name) == 1 and name.isdigit():
                self.sp_digit(name)
            elif name == "BackSpace":
                self.sp_back()
            elif name in ("Return", "KP_Enter"):
                self.sp_submit()
            else:
                return False
            return True
        if page != "login":
            return False
        name = Gdk.keyval_name(keyval) or ""
        if name.startswith("KP_") and name[3:].isdigit():
            name = name[3:]
        if len(name) == 1 and name.isdigit():
            self.on_digit(name)
        elif name == "BackSpace":
            self.on_back()
        elif name in ("Return", "KP_Enter"):
            self.submit()
        elif name == "Escape":
            self.pin.take()
            self.refresh_dots()
        else:
            return False
        return True

    # ============================================================ Login
    def submit(self):
        if self.busy or not len(self.pin) or not self.user or time.time() < self.locked_until:
            return
        self.busy = True
        pin = self.pin.take()
        self.refresh_dots()
        self.show_msg(i18n.tr(self.lang, "checking"))
        s = core.SESSIONS[self.mode]
        threading.Thread(target=self._login, args=(pin, s["cmd"], s["env"]), daemon=True).start()

    def _login(self, pin, cmd, env):
        try:
            g = Greetd()
            try:
                ok, code = g.login(self.user, pin, cmd, env)
            finally:
                g.close()
        except (GreetdError, OSError):
            ok, code = False, "error"
        GLib.idle_add(self._done, ok, code)

    def _done(self, ok, code):
        self.busy = False
        if ok:
            self.get_application().quit()
            return False
        self.failures += 1
        wait = core.backoff(self.failures)
        if wait:
            self.locked_until = time.time() + wait
        self.show_msg(i18n.tr(self.lang, code if code in i18n.T else "error"))
        if self.conf["shuffle"]:
            self.build_keypad()
        return False


def main():
    app = Gtk.Application(application_id="org.noxis.Greeter")

    def activate(a):
        css = Gtk.CssProvider()
        css.load_from_path(os.path.join(HERE, "style.css"))
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)
        win = Greeter(a)
        win.fullscreen()
        win.present()

    app.connect("activate", activate)
    return app.run([])


if __name__ == "__main__":
    sys.exit(main())

#!/bin/sh
set -e
[ "$1" = configure ] || exit 0

glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true

# Name in Einstellungen/hostnamectl: "Noxis Linux – Made by 3rr0r303YT".
# /usr/lib/os-release gehoert base-files; per dpkg-divert ersetzt, damit ein
# Update von base-files es nicht zurueckschreibt. ID_LIKE=debian bleibt,
# sonst erkennen apt-Werkzeuge das System nicht mehr.
if [ -f /usr/lib/noxis/brand/os-release ]; then
  dpkg-divert --package noxis-shell --add --rename \
    --divert /usr/lib/os-release.debian /usr/lib/os-release >/dev/null
  cp /usr/lib/noxis/brand/os-release /usr/lib/os-release
  ln -sf ../usr/lib/os-release /etc/os-release
  printf 'Noxis Linux 1.0 \\n \\l\n\n' > /etc/issue
  printf 'Noxis Linux 1.0\n' > /etc/issue.net
fi
command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true

# Startbildschirm
if command -v plymouth-set-default-theme >/dev/null; then
  plymouth-set-default-theme noxis 2>/dev/null || true
fi

# Display-Manager: noxis-dm + Greeter-Systemnutzer
if ! getent passwd noxis-greeter >/dev/null; then
  adduser --system --group --home /var/lib/noxis-greeter --shell /usr/sbin/nologin \
    --gecos "Noxis Greeter" noxis-greeter >/dev/null
fi
for g in video render input; do getent group "$g" >/dev/null && adduser noxis-greeter "$g" >/dev/null 2>&1 || true; done
install -d -m 0750 -o noxis-greeter -g noxis-greeter /var/lib/noxis-greeter

if [ -d /etc/systemd/system ]; then
  for dmsvc in greetd gdm3 lightdm sddm phosh; do
    systemctl disable "$dmsvc.service" >/dev/null 2>&1 || true
  done
  ln -sf /usr/lib/systemd/system/noxis-dm.service /etc/systemd/system/display-manager.service
  systemctl enable noxis-dm.service >/dev/null 2>&1 || true
  # seatd: phoc fragt /run/seatd.sock als erstes ab. Laeuft dort nichts, bleibt
  # nur logind, und das gibt die Sitzung nicht heraus, solange sie einem
  # anderen Benutzer gehoert ("Only owner of session may take control") -- die
  # Anmeldung springt dann sofort zum Greeter zurueck. Debian liefert den
  # Dienst mit, aktiviert ihn aber nicht.
  systemctl enable seatd.service >/dev/null 2>&1 || true
fi
# Mitglieder von _seatd duerfen den Socket benutzen.
if getent group _seatd >/dev/null; then
  for u in noxis noxis-greeter; do
    getent passwd "$u" >/dev/null && adduser "$u" _seatd >/dev/null 2>&1 || true
  done
fi
exit 0

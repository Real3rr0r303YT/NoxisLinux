// SPDX-License-Identifier: GPL-3.0-or-later
// Noxis Linux – Made by 3rr0r303YT on TikTok
// https://github.com/Real3rr0r303YT/NoxisLinux
//
// Eigenes Logo fuer fastfetch. Die lokale IP-Adresse fehlt absichtlich:
// fastfetch-Ausgaben landen in Screenshots und Videos.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/noxis/fastfetch/logo.txt",
    "color": { "1": "white", "2": "blue" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": { "separator": "  ", "color": { "keys": "blue" } },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "host", "key": "Geraet" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Laeuft" },
    { "type": "packages", "key": "Pakete" },
    { "type": "shell", "key": "Shell" },
    { "type": "wm", "key": "Oberflaeche" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "RAM" },
    { "type": "disk", "key": "Speicher" },
    { "type": "battery", "key": "Akku" },
    "break",
    { "type": "custom", "format": "Made by 3rr0r303YT on TikTok" },
    "break",
    "colors"
  ]
}

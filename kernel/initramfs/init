#!/bin/sh
# Noxis Linux – initramfs for the Nothing Phone (3a)
# Loads first-stage modules, mounts userdata (Noxis rootfs) + firmware partitions, starts systemd.
# Kernel parameters: noxis.debug=1 → USB network 172.16.42.1 + telnet shell (cable only), no further boot
#                    noxis.root=<partname> (default: userdata)

export PATH=/bin:/sbin
CMDLINE_FILE=${NOXIS_T_CMDLINE:-/proc/cmdline}
BOOTCONFIG_FILE=${NOXIS_T_BOOTCONFIG:-/proc/bootconfig}
SYS_BLOCK=${NOXIS_T_SYSBLOCK:-/sys/class/block}

early_mounts() {
  mkdir -p /proc /sys /dev /run /sysroot /tmp
  mount -t proc proc /proc
  mount -t sysfs sysfs /sys
  mount -t devtmpfs devtmpfs /dev 2>/dev/null
  mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
  mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
  mount -t configfs configfs /sys/kernel/config 2>/dev/null
}

log() { echo "noxis-init: $*" > /dev/kmsg 2>/dev/null || echo "noxis-init: $*"; }

cmdline_get() {  # $1 = key
  for a in $(cat "$CMDLINE_FILE"); do
    case "$a" in "$1"=*) echo "${a#*=}"; return 0 ;; esac
  done
  return 1
}

bootconfig_get() {  # $1 = key from /proc/bootconfig
  # Tolerant gegenueber Leerzeichen und Anfuehrungszeichen: 'key = "v"',
  # 'key="v"' und 'key = v' kommen je nach Bootloader vor.
  [ -r "$BOOTCONFIG_FILE" ] || return 1
  grep -m1 "^$1[[:space:]]*=" "$BOOTCONFIG_FILE" \
    | sed 's/^[^=]*=[[:space:]]*//; s/^"//; s/"[[:space:]]*$//; s/[[:space:]]*$//'
}

detect_slot() {
  s=$(bootconfig_get androidboot.slot_suffix)
  [ -n "$s" ] || s=$(cmdline_get androidboot.slot_suffix)
  [ -n "$s" ] || { s=$(bootconfig_get androidboot.slot); [ -n "$s" ] && s="_$s"; }
  [ -n "$s" ] || { s=$(cmdline_get androidboot.slot); [ -n "$s" ] && s="_$s"; }
  case "$s" in _a|_b) echo "$s"; return 0 ;; a|b) echo "_$s"; return 0 ;; esac
  # Kein Hinweis gefunden: wenn es A/B-Firmware gibt, Slot a annehmen und das
  # laut sagen. Ohne Suffix findet sich modem/dsp auf diesem Geraet nie, und
  # dann startet weder ADSP (Akku), noch Modem, noch WLAN.
  if find_part modem_a >/dev/null; then
    log "slot suffix unknown (bootconfig/cmdline) - assuming _a"
    echo "_a"
  fi
}

find_part() {  # $1 = PARTNAME → /dev/sdXN
  for u in "$SYS_BLOCK"/*/uevent; do
    [ -r "$u" ] || continue
    if grep -qx "PARTNAME=$1" "$u"; then
      echo "/dev/$(sed -n 's/^DEVNAME=//p' "$u")"
      return 0
    fi
  done
  return 1
}

wait_part() {  # $1 = PARTNAME, $2 = Sekunden
  i=0
  while [ "$i" -lt "$(( $2 * 10 ))" ]; do
    find_part "$1" && return 0
    sleep 0.1; i=$((i + 1))
  done
  return 1
}

load_modules() {
  KREL=$(uname -r)
  list=/lib/modules/$KREL/modules.load.noxis
  [ -f "$list" ] || { log "no module list $list"; return 0; }
  # Mehrere Durchlaeufe: ein Modul, dessen Symbol-Lieferant spaeter in der Liste
  # steht, scheitert im ersten Durchgang und laedt im naechsten. Abbruch, sobald
  # ein Durchlauf nichts mehr schafft.
  P=/tmp/noxis-mods; N=/tmp/noxis-mods.next
  cp "$list" "$P"
  ok=0; pass=0
  while :; do
    pass=$((pass + 1)); progress=0; : > "$N"
    while read -r m; do
      case "$m" in ''|'#'*) continue ;; esac
      if modprobe -q "${m%.ko}" 2>/dev/null; then
        ok=$((ok + 1)); progress=1
      else
        echo "$m" >> "$N"
      fi
    done < "$P"
    mv "$N" "$P"
    [ -s "$P" ] || break
    [ "$progress" -eq 1 ] || break
    [ "$pass" -ge 12 ] && break
  done
  fail=0
  while read -r m; do
    case "$m" in ''|'#'*) continue ;; esac
    fail=$((fail + 1)); log "module failed: $m"
  done < "$P"
  rm -f "$P" "$N"
  log "modules: $ok loaded, $fail failed ($pass passes)"
}

rebind_dwc3() {
  d=""
  for c in /sys/bus/platform/drivers/msm-dwc3 /sys/bus/platform/drivers/dwc3; do
    [ -d "$c" ] && { d="$c"; break; }
  done
  [ -n "$d" ] || { log "no dwc3 driver in sysfs"; return 1; }
  n=0
  for dev in /sys/bus/platform/devices/*ssusb* /sys/bus/platform/devices/*dwc3*; do
    [ -e "$dev" ] || continue
    b=${dev##*/}
    echo "$b" > "$d/unbind" 2>/dev/null
    if echo "$b" > "$d/bind" 2>/dev/null; then log "rebind $b ok"; n=$((n + 1)); else log "rebind $b failed"; fi
  done
  [ "$n" -gt 0 ] || log "no dwc3 device to rebind"
}

usb_debug() {
  g=/sys/kernel/config/usb_gadget/noxis
  # Auf den UDC warten: dwc3 bindet erst, wenn PMIC, Regulatoren und die
  # USB-PHYs durchgeprobt sind. Direkt nach dem Laden der Module ist
  # /sys/class/udc noch leer, auch wenn alles in Ordnung ist.
  i=0; udc=""; rebound=0
  while [ "$i" -lt "${NOXIS_UDC_TRIES:-150}" ]; do
    udc=$(ls /sys/class/udc 2>/dev/null | head -n1)
    [ -n "$udc" ] && break
    # dwc3 probt, bevor die eUSB2-PHY gebunden ist, gibt nach wenigen
    # Millisekunden auf und wird danach nicht mehr angestossen. Einmal von
    # Hand neu binden, sobald die PHY Zeit hatte.
    if [ "$i" -ge 50 ] && [ "$rebound" -eq 0 ]; then
      rebound=1; rebind_dwc3
    fi
    sleep 0.1; i=$((i + 1))
  done
  if [ -z "$udc" ]; then
    log "no USB controller (UDC) after $((i / 10))s"
    log "dwc3: $(ls -d /sys/bus/platform/drivers/dwc3/*/ 2>/dev/null | tr '\n' ' ')"
    return 1
  fi
  [ "$i" -gt 0 ] && log "UDC $udc after $((i / 10))s"
  mkdir -p "$g" || return 1
  echo 0x18D1 > "$g/idVendor"; echo 0xD001 > "$g/idProduct"
  mkdir -p "$g/strings/0x409"
  echo "Noxis"         > "$g/strings/0x409/manufacturer"
  echo "Noxis Debug"   > "$g/strings/0x409/product"
  echo "noxis"         > "$g/strings/0x409/serialnumber"
  fn=ncm.usb0
  mkdir -p "$g/functions/$fn" 2>/dev/null || { fn=rndis.usb0; mkdir -p "$g/functions/$fn" || return 1; }
  mkdir -p "$g/configs/c.1/strings/0x409"
  echo "$fn" > "$g/configs/c.1/strings/0x409/configuration"
  ln -s "$g/functions/$fn" "$g/configs/c.1/" 2>/dev/null
  echo "$udc" > "$g/UDC" || return 1
  sleep 1
  ip link set usb0 up 2>/dev/null || ifconfig usb0 up
  ip addr add 172.16.42.1/24 dev usb0 2>/dev/null || ifconfig usb0 172.16.42.1 netmask 255.255.255.0
  udhcpd -S /etc/udhcpd.conf 2>/dev/null
  telnetd -b 172.16.42.1:23 -l /bin/sh
  log "USB debug active: telnet 172.16.42.1 (function $fn, UDC $udc)"
}

rescue() {
  log "ERROR: $* – rescue mode"
  rescue_mode
}

# Noxis Rescue: USB-Netz 172.16.42.1, Telnet-Shell und der Befehlsdienst
# noxis-rescued auf Port 4242 (PC: kernel/tools/noxis-rescue.sh). Ersetzt den
# Umweg ueber Stock-Recovery fuer Logs, Backups und das Zurueckspielen.
rescue_mode() {
  log "Noxis Rescue – USB 172.16.42.1, Port 4242 (noxis-rescue.sh), telnet"
  echo "${SLOT:-?}" > /run/noxis-slot
  usb_debug || log "Rescue: kein USB-Netz"
  while :; do
    nc -l -p 4242 -e /bin/noxis-rescued 2>/dev/null || sleep 1
  done
}

want_rescue() {  # Ausloeser: Kernel-Parameter, Marker im Rootfs, oder mode=recovery
  [ "$(cmdline_get noxis.rescue)" = 1 ] && return 0
  [ "$(bootconfig_get androidboot.mode)" = recovery ] && return 0
  # force_normal_boot=0 war hier auch ein Ausloeser. Auf diesem Geraet ist
  # "fastboot reboot recovery" aber der einzige Weg, auf dem Noxis ueberhaupt
  # hochkommt – ein normales "fastboot reboot" bleibt schwarz. Damit ist
  # "recovery" der normale Startweg und darf keinen Rescue bedeuten, sonst
  # waere Noxis selbst nicht mehr erreichbar. Rescue kommt ueber
  # noxis.rescue=1 oder den Marker /.noxis-rescue (Knopf in der Oberfläche).
  return 1
}

# ---------------------------------------------------------------- main
[ "${NOXIS_T_LIB:-0}" = 1 ] && return 0 2>/dev/null   # tests: load functions only
early_mounts
load_modules

SLOT=$(detect_slot)
ROOT_PART=$(cmdline_get noxis.root) || ROOT_PART=userdata

log "boot: mode=$(bootconfig_get androidboot.mode) force_normal_boot=$(bootconfig_get androidboot.force_normal_boot) bootreason=$(bootconfig_get androidboot.bootreason)"
# Alle drei Werte kamen leer zurueck, obwohl der Kernel mit "bootconfig"
# startet. Darum hier, woran es liegt: fehlt die Datei, ist sie leer, oder
# heissen die Schluessel anders? Ohne das raten wir bei Slot und Rescue.
if [ -r "$BOOTCONFIG_FILE" ]; then
  log "bootconfig: $(wc -l < "$BOOTCONFIG_FILE") Zeilen; androidboot-Schluessel: $(grep -c androidboot "$BOOTCONFIG_FILE" 2>/dev/null)"
  log "bootconfig erste Zeilen: $(head -c 300 "$BOOTCONFIG_FILE" | tr '\n' '|')"
else
  log "bootconfig: $BOOTCONFIG_FILE nicht lesbar"
fi
want_rescue && rescue_mode

if [ "$(cmdline_get noxis.debug)" = 1 ]; then
  usb_debug
  log "noxis.debug=1 – staying in the initramfs"
  exec sh
fi

ROOT_DEV=$(wait_part "$ROOT_PART" 20) || rescue "partition $ROOT_PART not found"
log "Root: $ROOT_DEV (Slot ${SLOT:-?})"
e2fsck -p "$ROOT_DEV" >/dev/null 2>&1
mount -t ext4 -o rw,noatime,nodev "$ROOT_DEV" /sysroot || rescue "mounting $ROOT_DEV failed"
[ -x /sysroot/sbin/init ] || [ -L /sysroot/sbin/init ] || rescue "no /sbin/init on $ROOT_DEV"

# "Neustart in Rescue" aus Noxis legt /.noxis-rescue an (einmalig).
if [ -e /sysroot/.noxis-rescue ]; then
  rm -f /sysroot/.noxis-rescue; sync; umount /sysroot
  rescue_mode
fi

# firmware: modem (vfat) and dsp (ext4) of the active slot, read-only
mkdir -p /sysroot/vendor/firmware_mnt /sysroot/vendor/dsp
if p=$(find_part "modem$SLOT"); then
  mount -t vfat -o ro,nosuid,nodev,noexec,shortname=lower "$p" /sysroot/vendor/firmware_mnt \
    && log "firmware: modem$SLOT ($p) mounted" || log "modem$SLOT not mounted"
else
  log "firmware: partition modem$SLOT not found - ADSP, modem, WLAN and battery will not start"
fi
if p=$(find_part "dsp$SLOT"); then
  mount -t ext4 -o ro,nosuid,nodev,noexec "$p" /sysroot/vendor/dsp \
    && log "firmware: dsp$SLOT ($p) mounted" || log "dsp$SLOT not mounted"
else
  log "firmware: partition dsp$SLOT not found"
fi

for m in /dev /proc /sys /run; do mount --move "$m" "/sysroot$m" 2>/dev/null || mount -o bind "$m" "/sysroot$m"; done
exec switch_root /sysroot /sbin/init

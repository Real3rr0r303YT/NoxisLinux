# Noxis Linux – kernel fragment on top of gki_defconfig + vendor/pineapple_GKI.config + vendor/Asteroids.config
# Goal: Debian/systemd userspace on the Nothing GKI kernel (6.1, volcano/SM7635)

# --- systemd basics ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_AUTOFS_FS=y
CONFIG_INOTIFY_USER=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUP_PIDS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# --- nftables (Noxis-Firewall + Mullvad-Killswitch) ---
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_COMPAT=y
CONFIG_NF_NAT=y

# --- USB debug (NCM + RNDIS gadget) ---
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y

# --- hardening ---
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_LSM="landlock,lockdown,yama,selinux,bpf"
CONFIG_USER_NS=n
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n

# --- build our own modules instead of the Google KMI ---
CONFIG_TRIM_UNUSED_KSYMS=n
CONFIG_MODULE_SIG_PROTECT=n
CONFIG_MODULE_SIG_FORCE=n
CONFIG_MODULE_SIG_ALL=y
CONFIG_WERROR=n

# --- build time: no full LTO, no BTF (pahole) ---
CONFIG_LTO_NONE=y
CONFIG_LTO_CLANG_FULL=n
CONFIG_LTO_CLANG_THIN=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_BTF=n

# --- Bluetooth over UART (WCN6750, BlueZ via hci_uart + qca protocol) ---
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y

# Display: ohne CONFIG_DRM_MSM betritt display-drivers/Kbuild das msm/
# Unterverzeichnis nicht ("obj-$(CONFIG_DRM_MSM) += msm/"), und dort liegt
# erst die chipsatzabhaengige Konfiguration. Das Verzeichnis baut dann nur
# Hilfsmodule und meldet trotzdem Erfolg, msm_drm.ko fehlt. CONFIG_ARCH_PINEAPPLE
# ist gesetzt, also greift in msm/Kbuild der Pineapple-Zweig.
CONFIG_DRM_MSM=m
# Mit CONFIG_DRM_MSM=m schaltet Kconfig die Mainline-Unteroptionen gleich mit
# an. Der Techpack-Code kompiliert daraufhin Verweise auf mdp4_kms_init,
# mdp5_kms_init, msm_mdss_* und msm_hdmi_* hinein, deren Quelltext hier nicht
# existiert -- modpost bricht mit "undefined!" ab. DP und DSI bleiben an, die
# bringt display-drivers selbst mit (dp_*.o und dsi_*.o bauen sauber durch).
CONFIG_DRM_MSM_MDSS=n
CONFIG_DRM_MSM_MDP4=n
CONFIG_DRM_MSM_MDP5=n
CONFIG_DRM_MSM_HDMI=n
CONFIG_DRM_MSM_HDMI_HDCP=n

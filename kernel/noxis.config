# Noxis Linux – Kernel-Fragment über gki_defconfig + vendor/pineapple_GKI.config + vendor/Asteroids.config
# Ziel: Debian/systemd-Userspace auf dem Nothing-GKI-Kernel (6.1, volcano/SM7635)

# --- systemd-Grundlagen ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_AUTOFS_FS=y
CONFIG_INOTIFY_USER=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUP_PIDS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# --- nftables (Noxis-Firewall + Mullvad-Killswitch) ---
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_COMPAT=y
CONFIG_NF_NAT=y

# --- USB-Debug (NCM + RNDIS-Gadget) ---
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y

# --- Härtung ---
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_LSM="landlock,lockdown,yama,selinux,bpf"
CONFIG_USER_NS=n
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n

# --- eigene Module bauen statt Google-KMI ---
CONFIG_TRIM_UNUSED_KSYMS=n
CONFIG_MODULE_SIG_PROTECT=n
CONFIG_MODULE_SIG_FORCE=n
CONFIG_MODULE_SIG_ALL=y
CONFIG_WERROR=n

# --- Bauzeit: kein Voll-LTO, kein BTF (pahole) ---
CONFIG_LTO_NONE=y
CONFIG_LTO_CLANG_FULL=n
CONFIG_LTO_CLANG_THIN=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_BTF=n

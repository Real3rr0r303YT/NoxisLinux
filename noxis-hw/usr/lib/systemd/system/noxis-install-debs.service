[Unit]
Description=Noxis: install packages dropped in by noxis-diag.sh debs
ConditionDirectoryNotEmpty=/var/cache/noxis-debs
After=local-fs.target
Before=noxis-radios.service rmtfs.service

[Service]
Type=oneshot
ExecStart=/usr/lib/noxis/hw/noxis-install-debs

[Install]
WantedBy=multi-user.target

#
# Der Android-Kernel stellt den Modem-Speicher fuer rmtfs als UIO-Geraet
# bereit (msm_sharedmem, Name "rmtfs"). rmtfs sucht ihn unter
# /dev/qcom_rmtfs_uio1 -- ohne diesen Link: "failed to open
# /dev/qcom_rmtfs_uio1", das Modem bleibt ohne EFS, WLAN ohne MAC.
SUBSYSTEM=="uio", ATTR{name}=="rmtfs", SYMLINK+="qcom_rmtfs_uio1", MODE="0600"

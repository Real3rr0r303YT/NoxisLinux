#
# USB-Netz im laufenden Noxis: der PC bekommt eine Shell aufs Handy.
#
# Das Handy meldet sich als Netzwerkkarte am USB-Kabel, bekommt 172.16.42.1,
# und sshd nimmt darauf Verbindungen an. Vom PC aus:  kernel/tools/noxis-shell.sh
#
# Derselbe Aufbau wie im Rescue (kernel/initramfs/init, usb_debug) – dort ist
# er auf diesem Geraet erprobt. Unterschied: kein telnetd, sondern SSH, und die
# Firewall bekommt eine eng begrenzte Ausnahme.
#
# ACHTUNG, bewusste Abwaegung: Noxis blockt sonst JEDEN eingehenden Verkehr.
# Dieser Dienst oeffnet SSH – aber ausschliesslich auf usb0, also nur fuer
# jemanden, der ein Kabel ansteckt. Kein WLAN, kein Mobilfunk. Darum ist der
# Dienst auch nicht von selbst an; er wird mit "noxis-diag.sh usbnet" oder mit
# "systemctl enable --now noxis-usbnet" eingeschaltet.
set -u

G=/sys/kernel/config/usb_gadget/noxis
IP=172.16.42.1/24

log() { echo "noxis-usbnet: $*"; }

# ACHTUNG: hier stand einmal ein rebind_dwc3(), das bei ausbleibendem
# USB-Controller in /sys/bus/platform/drivers/msm-dwc3/unbind schrieb, um den
# Treiber neu anzubinden. Im vollen System fuehrt das zu:
#   pc : dwc3_msm_remove+0x2c/0x5a4 [dwc3_msm]
#   Kernel panic - not syncing: Oops: Fatal exception
# also zu einer Neustart-Schleife bei jedem Boot. Im Initramfs war der Zweig
# nie noetig und damit nie erprobt. Es wird hier nichts mehr ent- oder neu
# angebunden: ist kein Controller da, wird das gemeldet und der Dienst gibt
# auf. Ein fehlendes USB-Netz ist ein Nachteil, ein Kernel-Absturz nicht.
wait_udc() {
  i=0; udc=""
  while [ "$i" -lt 100 ]; do
    udc=$(ls /sys/class/udc 2>/dev/null | head -n1)
    [ -n "$udc" ] && break
    sleep 0.1; i=$((i + 1))
  done
  [ -n "$udc" ] || return 1
  echo "$udc"
}

# Die Ausnahme muss IN die Kette von noxis-opsec. Eine eigene Tabelle nuetzt
# nichts: in nftables werden alle Basisketten durchlaufen, und ein "accept" in
# der einen hebt ein "drop" in der anderen nicht auf. Darum haengen wir die
# Regeln zur Laufzeit ein und nehmen sie beim Stoppen am Kommentar wieder raus.
# Die ausgelieferte firewall.nft bleibt unveraendert: ohne diesen Dienst ist
# auch die Luecke weg.
TAG="noxis-usbnet"

firewall_open() {
  command -v nft >/dev/null 2>&1 || return 0
  nft list table inet noxis >/dev/null 2>&1 || { log "Firewall-Tabelle nicht aktiv – nichts zu oeffnen"; return 0; }
  firewall_close
  nft insert rule inet noxis input iifname \"usb0\" tcp dport 22 accept comment \"$TAG\" 2>/dev/null
  nft insert rule inet noxis input iifname \"usb0\" icmp type echo-request accept comment \"$TAG\" 2>/dev/null
  nft insert rule inet noxis output oifname \"usb0\" accept comment \"$TAG\" 2>/dev/null
  log "Firewall: SSH und Ping auf usb0 frei (sonst nichts)"
}

firewall_close() {
  command -v nft >/dev/null 2>&1 || return 0
  nft list table inet noxis >/dev/null 2>&1 || return 0
  # Nach Handle loeschen; die Liste von hinten abarbeiten, damit sich die
  # uebrigen Handles nicht verschieben.
  for ch in input output; do
    nft -a list chain inet noxis "$ch" 2>/dev/null \
      | grep "$TAG" | sed -n 's/.*# handle \([0-9]*\)$/\1/p' | sort -rn \
      | while read -r h; do
          [ -n "$h" ] && nft delete rule inet noxis "$ch" handle "$h" 2>/dev/null
        done
  done
}

start() {
  [ -d /sys/kernel/config ] || mount -t configfs none /sys/kernel/config 2>/dev/null
  modprobe libcomposite 2>/dev/null

  if [ -e "$G/UDC" ] && [ -n "$(cat "$G/UDC" 2>/dev/null)" ]; then
    log "Gadget laeuft schon"
  else
    udc=$(wait_udc) || { log "kein USB-Controller (UDC) gefunden"; return 1; }
    log "UDC: $udc"
    mkdir -p "$G" || return 1
    echo 0x18D1 > "$G/idVendor"  2>/dev/null
    echo 0xD001 > "$G/idProduct" 2>/dev/null
    mkdir -p "$G/strings/0x409"
    echo "Noxis"       > "$G/strings/0x409/manufacturer" 2>/dev/null
    echo "Noxis Linux" > "$G/strings/0x409/product"      2>/dev/null
    echo "noxis"       > "$G/strings/0x409/serialnumber" 2>/dev/null
    # ncm ist sauberer, rndis versteht aber jeder aeltere Kernel.
    fn=ncm.usb0
    mkdir -p "$G/functions/$fn" 2>/dev/null || {
      fn=rndis.usb0; mkdir -p "$G/functions/$fn" || { log "keine Netz-Funktion moeglich"; return 1; }
    }
    mkdir -p "$G/configs/c.1/strings/0x409"
    echo "$fn" > "$G/configs/c.1/strings/0x409/configuration" 2>/dev/null
    ln -s "$G/functions/$fn" "$G/configs/c.1/" 2>/dev/null
    echo "$udc" > "$G/UDC" || { log "UDC binden fehlgeschlagen"; return 1; }
    log "Funktion $fn an $udc"
    sleep 1
  fi

  # Das Netzgeraet usb0 erscheint erst eine Weile nach dem Binden des UDC.
  # Vorher lief "ip addr add" ins Leere, der PC sah zwar ein USB-Geraet, das
  # Handy hatte aber keine Adresse und antwortete auf nichts.
  i=0
  while [ "$i" -lt 100 ]; do
    [ -e /sys/class/net/usb0 ] && break
    sleep 0.1; i=$((i + 1))
  done
  if [ ! -e /sys/class/net/usb0 ]; then
    log "usb0 ist nicht erschienen – Gadget gebunden, aber kein Netzgeraet"
    return 1
  fi
  ip link set usb0 up 2>/dev/null
  ip addr add "$IP" dev usb0 2>/dev/null
  ip -4 addr show usb0 | grep -q "${IP%/*}" \
    && log "usb0: ${IP}" || { log "konnte ${IP} nicht auf usb0 legen"; return 1; }
  firewall_open
  # openssh kann beim ersten Start noch installiert werden (noxis-install-debs).
  # Darum mehrmals versuchen, statt einmal aufzugeben.
  i=0
  while [ "$i" -lt 30 ]; do
    systemctl is-active ssh >/dev/null 2>&1 && break
    systemctl start ssh >/dev/null 2>&1 || systemctl start sshd >/dev/null 2>&1
    systemctl is-active ssh >/dev/null 2>&1 || systemctl is-active sshd >/dev/null 2>&1 && break
    sleep 2; i=$((i + 1))
  done
  if systemctl is-active ssh >/dev/null 2>&1 || systemctl is-active sshd >/dev/null 2>&1; then
    log "bereit: ssh auf ${IP%/*} (PC: kernel/tools/noxis-shell.sh)"
  else
    log "usb0 steht, aber sshd laeuft nicht (openssh-server installiert?)"
  fi
}

stop() {
  firewall_close
  [ -e "$G/UDC" ] && echo "" > "$G/UDC" 2>/dev/null
  log "aus"
}

case "${1:-start}" in
  start) start ;;
  stop)  stop ;;
  *)     echo "Nutzung: noxis-usbnet start|stop"; exit 1 ;;
esac

# Installiert .deb-Dateien, die noxis-diag.sh debs vom PC aus abgelegt hat.
# dpkg laeuft hier nativ auf dem Handy, nicht in der Recovery.
set -u
D=/var/cache/noxis-debs
ls "$D"/*.deb >/dev/null 2>&1 || exit 0
echo "noxis-install-debs: $(ls "$D" | tr '\n' ' ')"
if dpkg -i "$D"/*.deb; then
  echo "noxis-install-debs: ok"
else
  echo "noxis-install-debs: dpkg meldet Fehler (fehlende Abhaengigkeiten?)"
  dpkg --configure -a || true
fi
rm -f "$D"/*.deb
systemctl daemon-reload
# pd-mapper sofort starten, damit das Modem seine Dienste findet
systemctl enable --now pd-mapper.service 2>/dev/null || true
exit 0

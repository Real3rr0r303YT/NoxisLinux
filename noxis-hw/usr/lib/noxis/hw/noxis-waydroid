#
# Waydroid einrichten und starten.
#
#   noxis-waydroid pruefen    nur nachsehen, nichts aendern
#   noxis-waydroid einrichten Abbild holen und einrichten (braucht Internet)
#   noxis-waydroid start      Behaelter und Sitzung starten, Oberflaeche zeigen
#   noxis-waydroid stop       Sitzung und Behaelter anhalten
#   noxis-waydroid weg        Abbild und Einstellungen loeschen
#
# Der Android-Kernel von Nothing bringt binder mit - das ist sonst die
# groesste Huerde. Dafuer fehlt die GPU-Beschleunigung, also laeuft Android
# in Software. Das ist langsam, aber es laeuft.
set -u
c()  { printf '\033[1;36m[waydroid]\033[0m %s\n' "$*"; }
ok() { printf '\033[1;32m[  ok  ]\033[0m %s\n' "$*"; }
no() { printf '\033[1;31m[fehlt ]\033[0m %s\n' "$*"; }
du_() { printf '\033[1;33m[ DU   ]\033[0m %s\n' "$*"; }
root() { [ "$(id -u)" = 0 ] || { no "bitte mit sudo starten"; exit 1; }; }

kconf() {  # eine Kernel-Einstellung nachsehen (CONFIG_IKCONFIG_PROC=y ist an)
  [ -r /proc/config.gz ] || return 2
  zcat /proc/config.gz 2>/dev/null | grep -q "^$1=y" && return 0
  return 1
}

pruefen() {
  rc=0
  c "Kernel"
  for o in CONFIG_ANDROID_BINDER_IPC CONFIG_ANDROID_BINDERFS; do
    case "$(kconf "$o"; echo $?)" in
      0) ok "$o" ;;
      1) no "$o - ohne das startet Waydroid nicht"; rc=1 ;;
      *) c "  $o: /proc/config.gz nicht lesbar, ungeprueft" ;;
    esac
  done
  if [ -d /dev/binderfs ]; then ok "/dev/binderfs eingehaengt"
  elif grep -q binder /proc/filesystems 2>/dev/null; then c "  binderfs da, aber nicht eingehaengt (macht der Behaelter selbst)"
  else no "kein binderfs im Kernel"; rc=1; fi
  ls /dev/binder* >/dev/null 2>&1 && ok "binder-Geraete: $(ls -d /dev/binder* /dev/hwbinder /dev/vndbinder 2>/dev/null | tr '\n' ' ')"

  c "Pakete"
  for p in waydroid lxc; do
    v=$(dpkg-query -W -f='${Version}' "$p" 2>/dev/null)
    [ -n "$v" ] && ok "$p $v" || { no "$p nicht installiert"; rc=1; }
  done

  c "Abbild"
  if [ -f /var/lib/waydroid/images/system.img ]; then
    ok "system.img da ($(du -h /var/lib/waydroid/images/system.img | cut -f1))"
  else
    no "kein Android-Abbild - 'noxis-waydroid einrichten' holt es (etwa 1 GB)"
    rc=2
  fi

  c "Weg nach draussen (fuer den Download)"
  if systemctl is-active --quiet noxis-firewall 2>/dev/null; then
    if mullvad status 2>/dev/null | grep -qi connected; then
      ok "Killswitch an, Mullvad verbunden"
    else
      no "Killswitch an, Mullvad NICHT verbunden - der Download wird blockiert"
      du_ "entweder Mullvad verbinden oder: noxis-diag.sh fw-aus (vom Rechner)"
      rc=1
    fi
  else
    ok "Killswitch aus"
  fi

  c "Anzeige"
  [ -n "${WAYLAND_DISPLAY:-}" ] && ok "Wayland: $WAYLAND_DISPLAY" \
    || c "  kein WAYLAND_DISPLAY - 'start' nur aus der angemeldeten Sitzung"
  [ -e /dev/dri/renderD128 ] && c "  /dev/dri da; GPU-Beschleunigung ist trotzdem nicht eingerichtet" \
    || c "  kein /dev/dri - Android rendert in Software (langsam, aber geht)"
  return $rc
}

einrichten() {
  root
  pruefen; p=$?
  [ "$p" = 1 ] && { no "erst die Punkte oben beheben"; exit 1; }
  if [ -f /var/lib/waydroid/images/system.img ]; then
    ok "Abbild ist schon da - nichts zu holen"
  else
    c "hole das Android-Abbild (VANILLA, ohne Google-Dienste) - das dauert"
    waydroid init -c https://ota.waydro.id/system -v https://ota.waydro.id/vendor || {
      no "Download fehlgeschlagen"
      du_ "haengt meist am Killswitch oder an der Uhr. Pruefen: noxis-waydroid pruefen"
      exit 1
    }
  fi
  # Ohne eingerichtete GPU muss Android in Software zeichnen.
  b=/var/lib/waydroid/waydroid_base.prop
  if [ -f "$b" ] && ! grep -q "ro.hardware.gralloc" "$b"; then
    printf 'ro.hardware.gralloc=default\nro.hardware.egl=swiftshader\n' >> "$b"
    ok "Software-Rendering eingetragen"
  fi
  systemctl enable --now waydroid-container || { no "waydroid-container startet nicht"; exit 1; }
  ok "eingerichtet. Weiter mit:  noxis-waydroid start"
}

start() {
  [ -f /var/lib/waydroid/images/system.img ] || { no "noch kein Abbild - erst: sudo noxis-waydroid einrichten"; exit 1; }
  if [ "$(id -u)" = 0 ]; then
    no "'start' bitte OHNE sudo, als angemeldeter Benutzer"
    exit 1
  fi
  systemctl is-active --quiet waydroid-container || { no "waydroid-container laeuft nicht - erst: sudo noxis-waydroid einrichten"; exit 1; }
  c "Sitzung starten (der erste Start dauert einige Minuten)"
  waydroid session start >/dev/null 2>&1 &
  i=0
  while [ "$i" -lt 60 ]; do
    waydroid status 2>/dev/null | grep -qi "Session.*RUNNING" && break
    i=$((i + 1)); sleep 2
  done
  waydroid status 2>&1 | sed 's/^/  /'
  c "Oberflaeche oeffnen"
  waydroid show-full-ui
}

stop() { waydroid session stop 2>/dev/null; [ "$(id -u)" = 0 ] && systemctl stop waydroid-container; ok "angehalten"; }

weg() {
  root
  systemctl disable --now waydroid-container 2>/dev/null
  rm -rf /var/lib/waydroid /home/*/.local/share/waydroid
  ok "Abbild und Einstellungen geloescht"
}

kv() {  # maschinenlesbar fuer die Oberflaeche: nur Schluessel=Wert
  k=unbekannt
  if [ -r /proc/config.gz ]; then
    if kconf CONFIG_ANDROID_BINDER_IPC && kconf CONFIG_ANDROID_BINDERFS; then k=ok; else k=fehlt; fi
  elif ls /dev/binder* >/dev/null 2>&1 || grep -q binder /proc/filesystems 2>/dev/null; then
    k=ok
  fi
  echo "kernel=$k"
  dpkg-query -W -f='${Status}' waydroid 2>/dev/null | grep -q "ok installed" && echo "paket=ok" || echo "paket=fehlt"
  [ -f /var/lib/waydroid/images/system.img ] && echo "abbild=ok" || echo "abbild=fehlt"
  if systemctl is-active --quiet noxis-firewall 2>/dev/null \
     && ! mullvad status 2>/dev/null | grep -qi connected; then
    echo "netz=blockiert"
  else
    echo "netz=ok"
  fi
  systemctl is-active --quiet waydroid-container 2>/dev/null && echo "container=an" || echo "container=aus"
  waydroid status 2>/dev/null | grep -qi "Session.*RUNNING" && echo "sitzung=an" || echo "sitzung=aus"
}

case "${1:-pruefen}" in
  kv)         kv ;;
  pruefen)    pruefen ;;
  einrichten) einrichten ;;
  start)      start ;;
  stop)       stop ;;
  weg)        weg ;;
  *) sed -n '5,16p' "$0" | sed 's/^# \{0,1\}//' ;;
esac

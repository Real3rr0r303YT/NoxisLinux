#!/usr/bin/python3
"""Noxis – switch the WCN6750 Bluetooth power rail via the Qualcomm btpower driver.
usage: noxis-btpower on|off   (ioctl BT_CMD_PWR_CTRL = 0xbfad on /dev/btpower)"""
import fcntl
import os
import sys

BT_CMD_PWR_CTRL = 0xBFAD
DEV = os.environ.get("NOXIS_BTPOWER", "/dev/btpower")


def main(argv):
    if len(argv) != 2 or argv[1] not in ("on", "off"):
        print(__doc__.strip().splitlines()[1], file=sys.stderr)
        return 2
    try:
        fd = os.open(DEV, os.O_RDWR)
    except OSError as e:
        print(f"noxis-btpower: {DEV}: {e}", file=sys.stderr)
        return 1
    try:
        fcntl.ioctl(fd, BT_CMD_PWR_CTRL, 1 if argv[1] == "on" else 0)
    except OSError as e:
        print(f"noxis-btpower: ioctl failed: {e}", file=sys.stderr)
        return 1
    finally:
        os.close(fd)
    print(f"noxis-btpower: {argv[1]}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
